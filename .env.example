# Generate local values with: python scripts/configure-local.py
# This file is a schema/example, not usable runtime credentials.
# Keep real values only in ignored .env or your deployment secret store.
DATABASE_PASSWORD=
# Independent random secrets, each at least 32 bytes:
JWT_SECRET=
ML_SERVICE_TOKEN=
# Local bootstrap administrator; password is generated, never shared in Git.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
