{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "GitHub production environment release identity; no long-lived access keys.",
  "Parameters": {
    "GitHubRepository": {
      "Type": "String",
      "AllowedPattern": "[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+",
      "Description": "Exact owner/repository"
    },
    "OidcProviderArn": {
      "Type": "String",
      "Description": "Existing GitHub token.actions.githubusercontent.com IAM OIDC provider ARN"
    },
    "ApplicationStackArn": {
      "Type": "String",
      "Description": "Exact existing commerce CloudFormation stack ARN"
    },
    "CloudFormationServiceRoleArn": {
      "Type": "String",
      "Description": "Pre-provisioned CloudFormation service role authorized to update this application stack"
    },
    "EcrRepositoryArns": {
      "Type": "CommaDelimitedList",
      "Description": "Backend, frontend and ML ECR repository ARNs"
    }
  },
  "Resources": {
    "ReleaseRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "OidcProviderArn"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Fn::Sub": "repo:${GitHubRepository}:environment:production"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ReleaseExistingCommerceStack",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:DescribeImages",
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:InitiateLayerUpload",
                    "ecr:UploadLayerPart",
                    "ecr:CompleteLayerUpload",
                    "ecr:PutImage",
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer"
                  ],
                  "Resource": {
                    "Ref": "EcrRepositoryArns"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DescribeStacks",
                    "cloudformation:UpdateStack"
                  ],
                  "Resource": {
                    "Ref": "ApplicationStackArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecs:DescribeServices",
                    "ecs:DescribeTaskDefinition"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": {
                    "Ref": "CloudFormationServiceRoleArn"
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "cloudformation.amazonaws.com"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "ReleaseRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "ReleaseRole",
          "Arn"
        ]
      }
    }
  }
}
